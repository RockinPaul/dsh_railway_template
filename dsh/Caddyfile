{
	# Loopback-only, and only so the entrypoint can `caddy reload` once DSH has
	# printed its launch token. Caddy must start BEFORE that token exists, because
	# anything else leaves the port unserved while the container is already routable
	# and Railway's edge answers 502 — measured at 3s, and up to 60s when the token
	# line is slow. Nothing outside this container can reach 127.0.0.1:2019.
	admin 127.0.0.1:2019
	# Railway terminates TLS at its edge and speaks plain HTTP to this container.
	auto_https off
}

:{$PORT} {
	# Answered by Caddy itself: the platform health check carries no cookie, and DSH
	# answers every unauthenticated index request with 401.
	handle /up {
		respond "ok" 200
	}

	# `route`, not `handle`. Inside `handle` Caddy applies its own directive order,
	# in which `redir` sorts BEFORE `basic_auth`: the auto sign-in redirect below
	# then answers a credential-less `GET /` with 302 and the live token, handing
	# DSH's session to anyone who asks, while every other path still returns 401 and
	# the gate looks like it works. Measured on 2.11.2, and the reason for the
	# gateway test in the repository. `route` keeps the written order.
	route {
		# The edge gate. The entrypoint writes a basic_auth snippet here when
		# DSH_GATE_PASSWORD is set; otherwise the file is a comment and this is a
		# no-op. With auto sign-in armed, this gate is what actually keeps strangers
		# out, which is why the entrypoint arms one only alongside the other.
		import /run/caddy/gate.caddy

		# Auto sign-in. DSH mints a launch token per process and trades it for a
		# 30-day session cookie; the entrypoint writes that redirect here so a
		# deployer never has to read the token out of the deploy logs. The matcher
		# skips requests that already carry a session or a token, so a stale token
		# answers 401 once instead of looping.
		import /run/caddy/signin.caddy

		# DSH listens on loopback only. Caddy passes the client's Host through
		# untouched, which is required: DSH's /api trust fence demands that the
		# request Host be loopback or a --trusted-host entry AND that any Origin
		# equal that Host. Rewriting Host here turns every browser WebSocket into a
		# 403 while the page still loads.
		reverse_proxy 127.0.0.1:{$DSH_PORT} {
			header_up X-Forwarded-Proto https

			# Break the sign-in loop. DSH ends its token exchange with 303 to "/",
			# which is exactly what the redirect above matches, so the whole thing
			# terminates only because the session cookie comes back. When it does
			# not — blocked, cleared by an extension, or a locked-down profile —
			# the browser bounces between the two forever and Firefox gives up with
			# "The page isn't redirecting properly". Reported from a real browser.
			#
			# Landing that 303 on "/?signedin=1" instead means the second visit
			# never matches the redirect: it falls through to DSH, which answers a
			# single 401. A deployment whose cookies do not stick then shows one
			# honest error instead of an infinite loop.
			header_down Location ^/$ /?signedin=1
		}
	}
}
